     fn fetch(&self, request: Request) -> OwnedFuture<Box<dyn SuccessResponse>, ErrorResponse> {
+        // PS5 (no network): internet requests stay pending, as when nothing
+        // ran them. Failing them sent preloaders (Newgrounds ads) into their
+        // "connection error" path, which loops forever; pending, they carry on.
+        // Movies from the internet (ads, prerolls, trackers such as Nitrome's
+        // Adunit.swf or CPMStar) fail at once instead: their loaders treat it
+        // like an ad blocker and let the game start, while waiting forever
+        // left those games on their first frame.
+        #[cfg(ps5)]
+        tracing::info!("load {}", request.url());
+        #[cfg(ps5)]
+        if request.url().starts_with("http://") || request.url().starts_with("https://") {
+            let path = request.url().split(['?', '#']).next().unwrap_or("").to_ascii_lowercase();
+            if path.ends_with(".swf") {
+                tracing::warn!("no network on PS5, failing movie load: {}", request.url());
+                return fetch_path(self, "NullNavigatorBackend", "file:///nonexistent/ps5-offline.swf", None);
+            }
+            tracing::warn!("no network on PS5, leaving pending: {}", request.url());
+            return Box::pin(std::future::pending());
+        }
+        // Offline game packages keep server answers as files named after the
+        // request with its query (or posted form) glued on with '+', e.g.
+        // db/get_leveldata_e.php+id=1. Use one when it's there.
+        #[cfg(ps5)]
+        if let Some(packaged) = self.packaged_answer(&request) {
+            return fetch_path(self, "NullNavigatorBackend", &packaged, None);
+        }
         fetch_path(self, "NullNavigatorBackend", request.url(), None)
     }
 
