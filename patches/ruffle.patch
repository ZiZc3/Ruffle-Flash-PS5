+    /// The packaged file answering a local request with a query or posted
+    /// form ("name.php+id=1"), as a file:// URL, if such a file exists.
+    #[cfg(ps5)]
+    fn packaged_answer(&self, request: &Request) -> Option<String> {
+        let url = self.resolve_url(request.url()).ok()?;
+        if url.scheme() != "file" {
+            return None;
+        }
+        let mut plain = url.clone();
+        plain.set_query(None);
+        let path = url_to_file_path(&plain).ok()?;
+        let mut extras: Vec<String> = Vec::new();
+        if let Some(q) = url.query().filter(|q| !q.is_empty()) {
+            extras.push(q.to_string());
+        }
+        if let Some((data, _)) = request.body() {
+            if let Ok(form) = std::str::from_utf8(data) {
+                if !form.is_empty() {
+                    extras.push(form.to_string());
+                    // With several fields, each one alone (packages often
+                    // keep only the one that matters, like id=1).
+                    if form.contains('&') {
+                        extras.extend(form.split('&').map(String::from));
+                    }
+                }
+            }
+        }
+        if let Some(q) = url.query().filter(|q| q.contains('&')) {
+            extras.extend(q.split('&').map(String::from));
+        }
+        for extra in extras {
+            let candidate = PathBuf::from(format!("{}+{}", path.display(), extra));
+            if candidate.is_file() {
+                tracing::info!("packaged answer: {}", candidate.display());
+                return Url::from_file_path(&candidate).ok().map(|u| u.to_string());
+            }
+        }
+        None
+    }
